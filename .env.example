# Vercel Postgres (auto-set when you add Postgres via Vercel dashboard)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Stripe (from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL (set automatically on Vercel, needed for Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://newartwebsite.vercel.app

# Admin dashboard password (existing)
ADMIN_PASSWORD=

# Optional: Vercel Blob (existing, kept for backward compat)
BLOB_READ_WRITE_TOKEN=
